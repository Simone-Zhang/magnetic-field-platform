# Never commit real values. Production refuses to start without a strong audit key.
NODE_ENV=production
MCP_AUDIT_HMAC_KEY=replace-with-at-least-32-random-characters

# Approved snapshot directories. MCP opens files read-only and never writes here.
MCP_UNITY_DATA_ROOT=D:\31508\location2\final Experiment\MCPData
MCP_PLATFORM_DATA_ROOT=D:\31508\Documents\GithubPlatform\magnetic-field-platform\mcp-data
MCP_PLATFORM_REPORTS_ROOT=D:\31508\Documents\GithubPlatform\magnetic-field-platform\reports

# Put audit logs outside data roots in production. Do not put secrets in this directory.
MCP_AUDIT_DIR=D:\31508\mcp-audit\magnetic-field

# Hard safety limits. Lower values are safer.
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_MAX_CONCURRENCY=2
MCP_QUERY_TIMEOUT_MS=2000
MCP_MAX_FILES_PER_QUERY=200
MCP_MAX_RECORDS_SCANNED=50000
MCP_MAX_BYTES_PER_QUERY=20971520
MCP_MAX_FILE_BYTES=5242880
MCP_MAX_RESULT_ROWS=50
